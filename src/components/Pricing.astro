---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
const plans = [
  {
    name: 'Website', usd: '499', lkr: '150,000', featured: false, cta: 'Choose website',
    desc: 'A focused website for a new business, launch or redesign.',
    features: ['Landing page + up to 5 subpages', '1 CMS — blog, portfolio, etc.', 'Responsive design', 'SEO setup', 'Analytics setup', 'Deployment', 'Hosting within plan limits', 'Domain within plan allowance'],
  },
  {
    name: 'Commerce', usd: '799', lkr: '240,000', featured: true, cta: 'Choose commerce',
    desc: 'A complete website with an integrated online store.',
    features: ['Landing page + up to 10 subpages', 'Built-in e-commerce store', '1 CMS in addition to the store', 'Responsive design', 'SEO setup', 'Analytics setup', 'Deployment', 'Hosting within plan limits', 'Domain within plan allowance'],
  },
];
---
<section id="pricing" class="section">
  <div class="container-x">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <Eyebrow num="04" label="Packages" />
        <h2 class="h-section mt-6" data-split>Clear scope. Fixed pricing.</h2>
      </div>
      <p class="lead md:col-span-5" data-reveal>
        Choose the package that fits your website. 50% is paid to begin and the remaining 50% before launch.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:mt-20 md:grid-cols-2">
      {plans.map((p) => (
        <article class:list={['card flex flex-col p-7 md:p-10', p.featured && 'card--featured']} data-spotlight data-tilt-zone data-reveal>
          <div
            class:list={['plan__object', p.featured && 'plan__object--featured']}
            data-device={p.featured ? 'commerce' : 'website'}
            data-motion="spin"
            data-active="true"
            aria-hidden="true"
          ></div>
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-xl font-medium tracking-tight">{p.name}</h3>
            {p.featured && <span class="pill text-[0.7rem] uppercase tracking-[0.14em]"><i class="dot"></i>Most popular</span>}
          </div>
          <p class="mt-10 flex items-baseline gap-3">
            <span class="text-[clamp(3.75rem,7vw,6.5rem)] font-medium leading-none tracking-[-0.05em]">$<span data-count-to={p.usd}>{p.usd}</span></span>
            <span class="text-sm text-white/50">/ {p.lkr} LKR</span>
          </p>
          <p class="mt-5 text-white/70">{p.desc}</p>
          <ul class="mt-8 grid gap-3 border-t pt-8 text-[0.95rem] text-white/80 hairline">
            {p.features.map((f) => (
              <li class="flex gap-3">
                <svg class="check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" /></svg>
                {f}
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-10">
            <Button href="#start" label={p.cta} variant={p.featured ? 'light' : 'ghost'} arrow class="w-full" />
          </div>
        </article>
      ))}
    </div>

    <div class="card mt-4 grid gap-4 p-7 md:grid-cols-12 md:items-center md:p-10" data-spotlight data-reveal>
      <div class="md:col-span-5">
        <h3 class="text-xl font-medium tracking-tight">Website care</h3>
        <p class="mt-1 text-sm text-white/60">$30/month · $60/month for Commerce</p>
      </div>
      <p class="text-white/60 md:col-span-7">
        Optional ongoing care for fixes, maintenance and keeping the website aligned with current safety standards.
      </p>
    </div>
  </div>
</section>
