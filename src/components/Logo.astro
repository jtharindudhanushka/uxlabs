---
import { LOGO_PATHS, LOGO_VIEWBOX } from './logo-paths';
interface Props { class?: string; title?: string }
const { class: className = '', title = 'UX Labs' } = Astro.props;
---
<svg class={className} viewBox={LOGO_VIEWBOX} fill="currentColor" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={title}>
  {LOGO_PATHS.map((d) => <path d={d} />)}
</svg>
