---
import Logo from './Logo.astro';
---
<div class="preloader" aria-hidden="true" data-preloader>
  <div class="preloader__glow"></div>
  <div class="preloader__logo"><Logo /></div>
  <div class="preloader__meta">
    <span>Simple by design</span>
    <span class="preloader__count" data-count>000</span>
    <span>Built to grow</span>
  </div>
</div>
