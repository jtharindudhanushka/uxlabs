---
import Eyebrow from './Eyebrow.astro';
---
<section id="about" class="section overflow-hidden">
  <div class="container-x grid gap-14 md:grid-cols-12 md:items-center">
    <div class="md:col-span-6">
      <Eyebrow num="06" label="About UX Labs" />
      <h2 class="h-section mt-6 max-w-[14ch]" data-split>A small studio focused on digital products.</h2>
      <div class="mt-10 grid max-w-[48ch] gap-5">
        <p class="lead" data-reveal>UX Labs brings design and development together to create websites that are clear, considered and ready to use.</p>
        <p class="lead" data-reveal>We work with startups and growing businesses that want a strong digital presence without a drawn-out website project.</p>
      </div>
    </div>
    <div class="md:col-span-5 md:col-start-8" data-reveal>
      <div class="render-stage" data-tilt-zone>
        <div class="render-stage__device" data-device="logo" data-motion="turntable" data-active="true" aria-hidden="true"></div>
      </div>
      <p class="mt-4 flex justify-between text-xs uppercase tracking-[0.16em] text-white/40">
        <span>The studio</span><span>Design × Development</span>
      </p>
    </div>
  </div>
</section>
