---
import Eyebrow from './Eyebrow.astro';

const steps = [
  { key: 'brief', day: 0, label: 'Day 0', title: 'Brief & direction', text: 'We learn about your business, audience and requirements, then establish the scope and direction.' },
  { key: 'draft', day: 2, label: 'Day 2', title: 'First draft', text: 'A first design draft lands within two days, so you have something real to react to.' },
  { key: 'build', day: 6, label: 'Day 3–9', title: 'Refine & build', text: 'We brainstorm it together, refine the design and build it out, with progress shared throughout.' },
  { key: 'launch', day: 10, label: 'Day 10', title: 'Launch', text: 'Final refinements, testing across devices, and the finished website delivered.*' },
];
---
<section id="process" class="hscroll" data-hscroll>
  <div class="hscroll__sticky">
    <div class="container-x hscroll__head">
      <div>
        <Eyebrow num="03" label="Process" />
        <h2 class="h-section mt-6 max-w-[16ch]" data-split>A straightforward way to build a website.</h2>
      </div>
      <p class="hscroll__counter" aria-hidden="true">
        <span class="hscroll__counter-label">Day</span>
        <span class="hscroll__counter-num" data-day-counter>00</span>
      </p>
    </div>

    <div class="hscroll__rail" aria-hidden="true">
      <span class="hscroll__rail-fill" data-rail-fill></span>
    </div>

    <ol class="hscroll__track" data-hscroll-track>
      {steps.map((s, i) => (
        <li class:list={['stage', i === 0 && 'is-active']} data-stage data-day={s.day}>
          <div class="stage__object" data-device={s.key} data-motion="turn" aria-hidden="true"></div>
          <div class="stage__copy">
            <p class="stage__day"><span class="stage__node"></span>{s.label}</p>
            <h3 class="stage__title">{s.title}</h3>
            <p class="stage__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="container-x hscroll__note">
      *First draft within 2 days and delivery within 10 days for focused projects. Conditions apply: the final timeline depends on project scope and the speed of content and feedback.
    </p>
  </div>
</section>
