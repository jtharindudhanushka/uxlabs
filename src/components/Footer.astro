---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV, BOOKING_URL } from '../config';
const year = new Date().getFullYear();
---
<section class="section relative overflow-hidden text-center">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="orb bottom-[-55vmax] w-[85vmax]" data-cta-orb aria-hidden="true"></div>
  <div class="container-x relative">
    <p class="eyebrow justify-center" data-reveal>UX Labs</p>
    <h2 class="display mx-auto mt-6 max-w-[12ch] text-[clamp(3.2rem,10vw,11rem)]" data-split>
      Let's make something good.
    </h2>
    <p class="lead mx-auto mt-8 max-w-[40ch]" data-reveal>Have a website in mind? Start with a brief or book a conversation.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal>
      <Button href="#start" label="Start a project" arrow />
      <Button href={BOOKING_URL} label="Book a call" variant="ghost" />
    </div>
  </div>
</section>

<footer class="relative overflow-hidden border-t pt-14 hairline">
  <div class="container-x grid gap-10 md:grid-cols-3 md:items-start">
    <div>
      <p class="font-medium">UX Labs</p>
      <p class="mt-1 text-sm text-white/50">Websites, designed properly.</p>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70 md:justify-center" aria-label="Footer">
      {NAV.map((n) => <a class="u-link" href={n.href}>{n.label}</a>)}
    </nav>
    <p class="text-sm text-white/50 md:text-right">© {year} UX Labs</p>
  </div>
  <div class="container-x mt-16 overflow-hidden" aria-hidden="true">
    <div data-footer-logo>
      <Logo class="block h-auto w-full text-white/[0.07]" title="" />
    </div>
  </div>
</footer>
