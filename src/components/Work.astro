---
import Eyebrow from './Eyebrow.astro';

const placeholders = [
  { name: 'Project Two', type: 'Website', seed: 3 },
  { name: 'Project Three', type: 'E-commerce', seed: 9 },
];

// A field of code for projects still in progress (deterministic per tile)
const glyphs = '{}<>/=+;:01#*%&$abcdef';
const codeField = (seed: number) => {
  let x = seed;
  const rnd = () => (x = (x * 16807) % 2147483647) / 2147483647;
  return Array.from({ length: 34 }, () =>
    Array.from({ length: 64 }, () => (rnd() < 0.62 ? glyphs[(rnd() * glyphs.length) | 0] : ' ')).join(''),
  ).join('\n');
};
---
<section id="work" class="section">
  <div class="container-x">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <Eyebrow num="01" label="Selected work" />
        <h2 class="h-section mt-6" data-split>A selection of recent work.</h2>
      </div>
      <p class="lead md:col-span-4" data-reveal>
        Recent websites and digital products from the studio. The work carries most of the proof.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:mt-20 md:grid-cols-12">
      <article class="work-card aspect-[4/5] md:col-span-7 md:row-span-2 md:aspect-auto md:min-h-[44rem]" data-cursor="WizeSage" data-reveal>
        <canvas
          class="work-card__canvas"
          data-ascii
          data-intro="false"
          data-anchor="0.5"
          data-src="/img/wizesage-phones.webp"
          role="img"
          aria-label="WizeSage digital profile app shown on two phones"
        ></canvas>
        <div class="work-card__label">
          <span class="pill">Project One · Website</span>
          <span class="pill pill--dark">WizeSage</span>
        </div>
      </article>

      {placeholders.map((p) => (
        <article class="work-card work-card--soon aspect-[16/11] md:col-span-5" data-reveal>
          <pre class="work-card__code" aria-hidden="true">{codeField(p.seed)}</pre>
          <div class="work-card__soon" aria-hidden="true"><i class="dot"></i>In progress</div>
          <div class="work-card__label">
            <span class="pill">{p.name} · {p.type}</span>
            <span class="pill pill--dark">Launching soon</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
