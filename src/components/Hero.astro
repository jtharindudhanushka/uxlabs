---
import Button from './Button.astro';
import worldMap from '../assets/world-ascii.txt?raw';
import subject from '../assets/hero/hero-desk.webp';

const stats = [
  { value: '2', prefix: '', suffix: '-day', title: 'first draft', text: 'Something real to react to, fast.' },
  { value: '10', prefix: '', suffix: '-day', title: 'delivery*', text: 'For focused projects with timely feedback.' },
  { value: '499', prefix: 'From $', suffix: '', title: '', text: 'Fixed project pricing.' },
];



// Violet "code" squares floating over the scene
const squares = [
  { x: 14, y: 30, s: 56, d: '0.0', code: ['ux.labs', '{draft}', '0x02'] },
  { x: 30, y: 72, s: 38, d: '1.2', code: ['</>', 'ok'] },
  { x: 72, y: 22, s: 72, d: '0.6', code: ['launch()', 'day=10', 'ship', '→ live'] },
  { x: 86, y: 64, s: 44, d: '1.8', code: ['seo', 'cms'] },
];
---
<section id="top" class="hero">
  <div class="hero__map" aria-hidden="true">
    <div class="hero__map-track"><pre>{worldMap}</pre><pre>{worldMap}</pre></div>
  </div>

  <div class="hero__fold">
  <div class="hero__copy container-x relative text-center">
    <div class="mb-7 flex flex-wrap items-center justify-center gap-4" data-hero-fade>
      <span class="pill"><i class="dot"></i>Available for work</span>
      <span class="eyebrow">Website design &amp; development · Worldwide</span>
    </div>

    <h1 class="hero__title display mx-auto" data-hero-title>
      <span class="hero__line" data-hero-line>Websites, designed <em class="serif">properly.</em></span>
      <span class="hero__line hero__line--2" data-hero-line>
        <span data-scramble>Delivered</span> <span class="text-grad" data-scramble>quickly.</span>
      </span>
    </h1>

    <p class="lead mx-auto mt-6 max-w-[46ch]" data-hero-fade>
      UX Labs creates considered websites for startups and growing businesses — from the first screen to the final launch.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3" data-hero-fade>
      <Button href="#pricing" label="View packages" arrow />
      <Button href="#start" label="Start a project" variant="ghost" />
    </div>
  </div>

  <div class="hero__scene" data-hero-scene>
    <div class="hero__art" style={`aspect-ratio:${subject.width} / ${subject.height}`}>
      <div class="hero__glow" aria-hidden="true"></div>
      <canvas
        class="hero__canvas"
        data-ascii-canvas
        data-src={subject.src}
        role="img"
        aria-label="A UX Labs design studio desk rendered from lines of code"
      ></canvas>
      {squares.map((q) => (
        <div class="code-square" style={`left:${q.x}%;top:${q.y}%;width:${q.s}px;height:${q.s}px;--d:${q.d}s`} data-square aria-hidden="true">
          {q.code.map((line) => <span>{line}</span>)}
        </div>
      ))}
    </div>
  </div>
  </div>

  <div class="container-x relative">
    <dl class="hero__stats" data-hero-fade>
      {stats.map((s) => (
        <div>
          <dt class="text-lg font-medium tracking-tight text-white md:text-xl">
            {s.value ? (
              <>{s.prefix}<span data-count-to={s.value}>{s.value}</span>{s.suffix} {s.title}</>
            ) : s.title}
          </dt>
          <dd class="mt-1.5 text-xs leading-relaxed text-white/50 md:text-sm">{s.text}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-center text-xs text-white/35" data-hero-fade>*Conditions apply — scope, content and feedback speed affect the timeline.</p>
  </div>
</section>
